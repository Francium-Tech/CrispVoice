# Everything heavy or personal stays out of the repo.

# Project-local Python runtime and environment (rebuilt by setup.sh)
.runtime/
.venv/

# Model weights (~713 MB, downloaded by setup.sh)
models/

# Audio: never commit recordings - they may contain someone's voice.
# Exception: the demo/ clips, published deliberately as a before/after sample.
samples/
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.aiff
!demo/noise.m4a
!demo/crispvoice.mp3

# OS / editor noise
.DS_Store
__pycache__/
*.pyc
